sha512sums="e46c9510bcb23fa846e869246c3d92026a6a82659a2e11588ce8a65084d8e49e9e9145ab5dcadd715a09e7ef22a5a8a19f5e942a594cb0a129c0426e0e81d76b  filsys-1.2.6.tar.gz"

build() {
	./configure --prefix=/usr || return 1
	make || return 1
}

package() {
	make DESTDIR="$pkgdir" install || return 1
}
