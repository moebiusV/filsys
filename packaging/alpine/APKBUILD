sha512sums="3c22ebc5374c02a5e4710187b48efa137920f01dcdbe1c6d8616613661aa5b3c1d91571527030c202d96438b72362441611c75a47b79f5a01f0101e66bc04271  filsys-1.2.7.tar.gz"

build() {
	./configure --prefix=/usr || return 1
	make || return 1
}

package() {
	make DESTDIR="$pkgdir" install || return 1
}
