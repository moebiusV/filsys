# Maintainer: maintainer <email>
pkgname=filsys
pkgver=1.2.0
pkgrel=0
pkgdesc="FUSE driver for Research Unix (V4-V7, 32V) filesystem images"
url="https://github.com/moebiusV/filsys"
arch="x86_64"
license="ISC AND Caldera"
makedepends="fuse3-dev build-base"
depends="fuse3"
# recommended (optional): v7unix-toolchain prebsd
source="https://github.com/moebiusV/filsys/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"
sha512sums="94674557c0b67097cd52e9a3e20b56983b90d81b4993b692a3e3f785a2476c93951ad6128791ad193efa9732c30a21efa3c11365d0eb679f5a29f92a0a636eb4  filsys-1.2.0.tar.gz"

build() {
	./configure --prefix=/usr || return 1
	make || return 1
}

package() {
	make DESTDIR="$pkgdir" install || return 1
}
