pkgname=filsys
pkgver=1.2.5
pkgrel=0
pkgdesc="FUSE driver for Research Unix (V0-V7, 32V) filesystem images"
url="https://github.com/moebiusV/filsys"
arch="x86_64"
license="ISC AND Caldera"
makedepends="fuse3-dev build-base"
depends="fuse3"
# recommended (optional): v7unix-toolchain prebsd
source="https://github.com/moebiusV/filsys/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"
sha512sums="f1f9e63054061a74b68d3a083ad6e155f0a79ff2032c241aad1ad3edf1a32d943853612e67c0a418ee0348eae96c02d047820d7f75651e028141d85f8c76b4dc  filsys-1.2.5.tar.gz"

build() {
	./configure --prefix=/usr || return 1
	make || return 1
}

package() {
	make DESTDIR="$pkgdir" install || return 1
}
