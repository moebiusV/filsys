# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=filsys
pkgver=4.1.2
pkgrel=1
pkgdesc="FUSE driver for Research Unix (PDP-7 through V10, 32V, Coherent, Xenix, 2.9/2.11BSD, System III/V) filesystem images"
arch=('x86_64')
url="https://github.com/moebiusV/filsys"
license=('ISC')
depends=('fuse3')
optdepends=('prebsd: boot the images on simh')
makedepends=('pkg-config')
source=("https://github.com/moebiusV/filsys/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('1cca6d5c8e44507bfd16a103456e55d34ac699cc1f2e7b3c7c286068d0d3e31d')

build() {
  cd "$pkgname-$pkgver"
  ./configure --prefix=/usr
  make
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
}
