# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=filsys
pkgver=1.0.0
pkgrel=1
pkgdesc="FUSE driver for V7 (PDP-11) Unix filesystem images"
arch=('x86_64')
url="https://github.com/moebiusV/filsys"
license=('LGPL2.1')
depends=('fuse3')
optdepends=('v7unix-toolchain: mkfs and fsck for the images' 'prebsd: boot the images on simh' 'simh: the PDP-11 emulator')
makedepends=('autoconf' 'automake' 'pkg-config')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  autoreconf -i
  ./configure --prefix=/usr
  make
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
}
