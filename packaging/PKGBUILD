# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=filsys
pkgver=1.2.1
pkgrel=1
pkgdesc="FUSE driver for V7 (PDP-11) Unix filesystem images"
arch=('x86_64')
url="https://github.com/moebiusV/filsys"
license=('ISC' 'Caldera')
depends=('fuse3')
optdepends=('prebsd: boot the images on simh')
makedepends=('pkg-config')
source=("https://github.com/moebiusV/filsys/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('eb703b355b9317c9f0075f5df302b77f0d3842b4cb7af0b86357bca6c0d23de2')

build() {
  cd "$pkgname-$pkgver"
  ./configure --prefix=/usr
  make
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
}
