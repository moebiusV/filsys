# Maintainer: David Walther <david@clearbrookdistillery.com>
pkgname=filsys
pkgver=1.2.4
pkgrel=1
pkgdesc="FUSE driver for Research Unix (V0-V7, 32V) filesystem images"
arch=('x86_64')
url="https://github.com/moebiusV/filsys"
license=('ISC' 'Caldera')
depends=('fuse3')
optdepends=('prebsd: boot the images on simh')
makedepends=('pkg-config')
source=("https://github.com/moebiusV/filsys/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('b66de0596036b1ce70fe44f048b44373f4fa71f55b9d3007575db62366bab8ed')

build() {
  cd "$pkgname-$pkgver"
  ./configure --prefix=/usr
  make
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
}
