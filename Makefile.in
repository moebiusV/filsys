mount_filsys_SOURCES = mount.filsys.c v6fs.c v6fs.h v7fs.c v7fs.h
# C17, not C23: Microsoft's toolchain tops out at C17, so we match.
mount_filsys_CFLAGS = -std=c17 -Wall -Wextra
mount_filsys_CPPFLAGS = -DFUSE_USE_VERSION=35 $(FUSE3_CFLAGS)
mount_filsys_LDADD = $(FUSE3_LIBS) -lpthread
findfs_filsys_SOURCES = findfs.filsys.c
findfs_filsys_CFLAGS = -std=c17 -Wall -Wextra
mkfs_filsys_SOURCES = mkfs.filsys.c v6fs.c v6fs.h v7fs.c v7fs.h
mkfs_filsys_CFLAGS = -std=c17 -Wall -Wextra
fsck_filsys_SOURCES = fsck.filsys.c v6fs.c v6fs.h v7fs.c v7fs.h
fsck_filsys_CFLAGS = -std=c17 -Wall -Wextra
dist_man_MANS = filsys.5 mount.filsys.1 findfs.filsys.1 mkfs.filsys.1 fsck.filsys.1
EXTRA_DIST = test.sh fetch.sh reference packaging boot/hpuboot.s \
	boot/rpuboot.s

# --- PDP-11 boot blocks -----------------------------------------------------
# filsys ships two block-0 bootstraps assembled from the V7 /usr/mdec sources:
# hpuboot (RP06/HP disk) and rpuboot (RP03/04/05/06 disk).  The prebuilt a.out
# files are installed with the package; pass one to `mkfs.filsys -b` to drop it
# into block 0 (see mkfs.filsys(1)).  Regenerate them from source with the
# ported V7 assembler:
#   make boot
# (the assembler ships in v7unix-toolchain at $(libexecdir)/v7unix/as; it finds
#  its as2 second pass next to itself, so no AS2 needs to be passed)
bootdir = $(pkgdatadir)
dist_boot_DATA = boot/hpuboot boot/rpuboot
all: all-am

.SUFFIXES:
.SUFFIXES: .c .o .obj
am--refresh: Makefile
	@:
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      echo ' cd $(srcdir) && $(AUTOMAKE) --gnu'; \
	      $(am__cd) $(srcdir) && $(AUTOMAKE) --gnu \
		&& exit 0; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --gnu Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --gnu Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    echo ' $(SHELL) ./config.status'; \
	    $(SHELL) ./config.status;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $@ $(am__maybe_remake_depfiles);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	$(SHELL) ./config.status --recheck

$(top_srcdir)/configure:  $(am__configure_deps)
	$(am__cd) $(srcdir) && $(AUTOCONF)
$(ACLOCAL_M4):  $(am__aclocal_m4_deps)
	$(am__cd) $(srcdir) && $(ACLOCAL) $(ACLOCAL_AMFLAGS)
$(am__aclocal_m4_deps):
install-binPROGRAMS: $(bin_PROGRAMS)
	@$(NORMAL_INSTALL)
	@list='$(bin_PROGRAMS)'; test -n "$(bindir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(bindir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(bindir)" || exit 1; \
	fi; \
	for p in $$list; do echo "$$p $$p"; done | \
	sed 's/$(EXEEXT)$$//' | \
	while read p p1; do if test -f $$p \
	  ; then echo "$$p"; echo "$$p"; else :; fi; \
	done | \
	sed -e 'p;s,.*/,,;n;h' \
	    -e 's|.*|.|' \
	    -e 'p;x;s,.*/,,;s/$(EXEEXT)$$//;$(transform);s/$$/$(EXEEXT)/' | \
	sed 'N;N;N;s,\n, ,g' | \
	$(AWK) 'BEGIN { files["."] = ""; dirs["."] = 1 } \
	  { d=$$3; if (dirs[d] != 1) { print "d", d; dirs[d] = 1 } \
	    if ($$2 == $$4) files[d] = files[d] " " $$1; \
	    else { print "f", $$3 "/" $$4, $$1; } } \
	  END { for (d in files) print "f", d, files[d] }' | \
	while read type dir files; do \
	    if test "$$dir" = .; then dir=; else dir=/$$dir; fi; \
	    test -z "$$files" || { \
	      echo " $(INSTALL_PROGRAM_ENV) $(INSTALL_PROGRAM) $$files '$(DESTDIR)$(bindir)$$dir'"; \
	      $(INSTALL_PROGRAM_ENV) $(INSTALL_PROGRAM) $$files "$(DESTDIR)$(bindir)$$dir" || exit $$?; \
	    } \
	; done

uninstall-binPROGRAMS:
	@$(NORMAL_UNINSTALL)
	@list='$(bin_PROGRAMS)'; test -n "$(bindir)" || list=; \
	files=`for p in $$list; do echo "$$p"; done | \
	  sed -e 'h;s,^.*/,,;s/$(EXEEXT)$$//;$(transform)' \
	      -e 's/$$/$(EXEEXT)/' \
	`; \
	test -n "$$list" || exit 0; \
	echo " ( cd '$(DESTDIR)$(bindir)' && rm -f" $$files ")"; \
	cd "$(DESTDIR)$(bindir)" && $(am__rm_f) $$files

clean-binPROGRAMS:
	-$(am__rm_f) $(bin_PROGRAMS)

findfs.filsys$(EXEEXT): $(findfs_filsys_OBJECTS) $(findfs_filsys_DEPENDENCIES) $(EXTRA_findfs_filsys_DEPENDENCIES) 
	@rm -f findfs.filsys$(EXEEXT)
	$(AM_V_CCLD)$(findfs_filsys_LINK) $(findfs_filsys_OBJECTS) $(findfs_filsys_LDADD) $(LIBS)

fsck.filsys$(EXEEXT): $(fsck_filsys_OBJECTS) $(fsck_filsys_DEPENDENCIES) $(EXTRA_fsck_filsys_DEPENDENCIES) 
	@rm -f fsck.filsys$(EXEEXT)
	$(AM_V_CCLD)$(fsck_filsys_LINK) $(fsck_filsys_OBJECTS) $(fsck_filsys_LDADD) $(LIBS)

mkfs.filsys$(EXEEXT): $(mkfs_filsys_OBJECTS) $(mkfs_filsys_DEPENDENCIES) $(EXTRA_mkfs_filsys_DEPENDENCIES) 
	@rm -f mkfs.filsys$(EXEEXT)
	$(AM_V_CCLD)$(mkfs_filsys_LINK) $(mkfs_filsys_OBJECTS) $(mkfs_filsys_LDADD) $(LIBS)

mount.filsys$(EXEEXT): $(mount_filsys_OBJECTS) $(mount_filsys_DEPENDENCIES) $(EXTRA_mount_filsys_DEPENDENCIES) 
	@rm -f mount.filsys$(EXEEXT)
	$(AM_V_CCLD)$(mount_filsys_LINK) $(mount_filsys_OBJECTS) $(mount_filsys_LDADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

