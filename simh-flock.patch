diff --git a/sim_disk.c b/sim_disk.c
index 6f938da..3b6606a 100644
--- a/sim_disk.c
+++ b/sim_disk.c
@@ -95,6 +95,24 @@ Internal routines:
 
 #include "sim_scp_private.h"
 
+/* FUSE-driver coordination.
+ *
+ * An external FUSE driver (v7fuse) mounts a disk image and holds an exclusive
+ * flock on the image file for the whole mount.  By taking that same flock
+ * around each sector read/write below, the emulator blocks -- and therefore
+ * pauses -- for the duration of the FUSE mount, and resumes as soon as the
+ * image is unmounted.  This keeps the two writers from touching the image at
+ * the same time.  On platforms without flock the macros compile away. */
+#if defined(__linux__) || defined(__APPLE__) || defined(__FreeBSD__) || \
+    defined(__NetBSD__) || defined(__OpenBSD__) || defined(__sun)
+#include <sys/file.h>
+#define SIM_DISK_LOCK(u)   flock (fileno ((FILE *)(u)->fileref), LOCK_EX)
+#define SIM_DISK_UNLOCK(u) flock (fileno ((FILE *)(u)->fileref), LOCK_UN)
+#else
+#define SIM_DISK_LOCK(u)
+#define SIM_DISK_UNLOCK(u)
+#endif
+
 #define DKUF_F_AUTO      0                              /* Auto detect format format */
 #define DKUF_F_STD       1                              /* SIMH format */
 #define DKUF_F_RAW       2                              /* Raw Physical Disk Access */
@@ -858,6 +876,8 @@ struct disk_context *ctx = (struct disk_context *)uptr->disk_ctx;
 
 sim_debug_unit (ctx->dbit, uptr, "_sim_disk_rdsect(unit=%d, lba=0x%X, sects=%d)\n", (int)(uptr - ctx->dptr->units), lba, sects);
 
+SIM_DISK_LOCK (uptr);
+
 da = ((t_offset)lba) * ctx->sector_size;
 tbc = sects * ctx->sector_size;
 if (sectsread)
@@ -867,8 +887,10 @@ while (tbc) {
 
     clearerr (uptr->fileref);
     err = sim_fseeko (uptr->fileref, da, SEEK_SET);          /* set pos */
-    if (err)
+    if (err) {
+        SIM_DISK_UNLOCK (uptr);
         return SCPE_IOERR;
+        }
     i = sim_fread (buf, 1, tbc, uptr->fileref);
     if (i < tbc)                 /* fill */
         memset (&buf[i], 0, tbc-i);
@@ -881,14 +903,19 @@ while (tbc) {
     if (sectsread)
         *sectsread += sectbytes / ctx->sector_size;
     err = ferror (uptr->fileref);
-    if (err)
+    if (err) {
+        SIM_DISK_UNLOCK (uptr);
         return SCPE_IOERR;
+        }
     tbc -= sectbytes;
-    if ((tbc == 0) || (i == 0))
+    if ((tbc == 0) || (i == 0)) {
+        SIM_DISK_UNLOCK (uptr);
         return SCPE_OK;
+        }
     da += sectbytes;
     buf += sectbytes;
     }
+SIM_DISK_UNLOCK (uptr);
 return SCPE_OK;
 }
 
@@ -1019,19 +1046,26 @@ struct disk_context *ctx = (struct disk_context *)uptr->disk_ctx;
 
 sim_debug_unit (ctx->dbit, uptr, "_sim_disk_wrsect(unit=%d, lba=0x%X, sects=%d)\n", (int)(uptr - ctx->dptr->units), lba, sects);
 
+SIM_DISK_LOCK (uptr);
+
 da = ((t_offset)lba) * ctx->sector_size;
 tbc = sects * ctx->sector_size;
 if (sectswritten)
     *sectswritten = 0;
 err = sim_fseeko (uptr->fileref, da, SEEK_SET);          /* set pos */
-if (err)
+if (err) {
+    SIM_DISK_UNLOCK (uptr);
     return SCPE_IOERR;
+    }
 i = sim_fwrite (buf, ctx->xfer_encode_size, tbc/ctx->xfer_encode_size, uptr->fileref);
 if (sectswritten)
     *sectswritten += (t_seccnt)((i * ctx->xfer_encode_size + ctx->sector_size - 1)/ctx->sector_size);
 err = ferror (uptr->fileref);
-if (err)
+if (err) {
+    SIM_DISK_UNLOCK (uptr);
     return SCPE_IOERR;
+    }
+SIM_DISK_UNLOCK (uptr);
 return SCPE_OK;
 }
 
