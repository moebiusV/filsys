prefix=@prefix@
exec_prefix=@exec_prefix@
includedir=@includedir@
libdir=@libdir@

Name: filsys
Description: Research Unix (PDP-7 through Tenth Edition, plus 32V, Coherent, early Xenix, 2.9/2.11BSD, System III and System V) filesystem image access library
Version: @PACKAGE_VERSION@
Libs: -L${libdir} -lfilsys
Cflags: -I${includedir}/filsys
